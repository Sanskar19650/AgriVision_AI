# GEMINI_API_KEY: Optional server-side Gemini Vision key for multimodal leaf/damage & 7/12 OCR analysis.
# AI Studio automatically injects this at runtime from user secrets when configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key (falls back to Open-Meteo real-time meteorological API if unset).
OPENWEATHER_API_KEY=""

# AI_BACKEND_URL: Optional URL of the Python FastAPI microservice (e.g. http://localhost:8000).
AI_BACKEND_URL=""

# BLOCKCHAIN_RPC_URL: Optional Ethereum/Polygon RPC URL for AgriVision.sol contract anchoring.
BLOCKCHAIN_RPC_URL=""
